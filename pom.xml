<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bmtest.finalgithub</groupId>
  <artifactId>finalGithub</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <properties>
	<jakarta-json.version>2.0.1</jakarta-json.version>
	<maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
	<jib-maven-plugin.version>3.4.4</jib-maven-plugin.version>
	<maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
	<java.version>21</java.version>
	<maven.compiler.release>21</maven.compiler.release>
  </properties>
  <parent>
	<groupId>org.springframework.boot</groupId>
	<artifactId>spring-boot-starter-parent</artifactId>
	<version>3.5.12</version>
  </parent>
  <modules>
  	<module>frontend</module>
  	<module>backend-base</module>
  	<module>application</module>
  </modules>
  <build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${maven.compiler.release}</release>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<extensions>
			<extension>
				<groupId>com.google.cloud.artifactregistry</groupId>
				<artifactId>artifactregistry-maven-wagon</artifactId>
				<version>2.2.0</version>
			</extension>
		</extensions>
	</build>
	<profiles>
		<profile>
			<id>default</id>
			<properties>
				<app-name>vb-eva-gen</app-name>
				<env-suffix>DEV</env-suffix>
				<local-env>true</local-env>
				<spring.profiles.active>Dev</spring.profiles.active>
				<ng-build-configuration>build</ng-build-configuration>
			</properties>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>prod</id>
			<properties>
				<app-name>vb-eva-gen</app-name>
				<app-version>1-0-0</app-version>
				<env-suffix>Prod</env-suffix>
				<spring.profiles.active>prod</spring.profiles.active>
				<memcached-ip>10.46.0.3:11211</memcached-ip>
				<client-secret>${CLIENT_SECRET}</client-secret>
				<client-id>${CLIENT_ID}</client-id>
				<ng-build-configuration>build</ng-build-configuration>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>dev</id>
			<properties>
				<app-name>vb-eva-gen</app-name>
				<app-version>1-0-0</app-version>
				<env-suffix>Dev</env-suffix>
				<spring.profiles.active>dev</spring.profiles.active>
				<memcached-ip>10.46.0.3:11211</memcached-ip>
				<client-secret>${CLIENT_SECRET}</client-secret>
				<client-id>${CLIENT_ID}</client-id>
				<ng-build-configuration>build</ng-build-configuration>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>test</id>
			<properties>
				<app-name>vb-eva-gen</app-name>
				<app-version>1-0-0</app-version>
				<env-suffix>Test</env-suffix>
				<spring.profiles.active>test</spring.profiles.active>
				<memcached-ip>10.46.0.3:11211</memcached-ip>
				<client-secret>${CLIENT_SECRET}</client-secret>
				<client-id>${CLIENT_ID}</client-id>
				<ng-build-configuration>build</ng-build-configuration>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>pre-prod</id>
			<properties>
				<app-name>vb-eva-gen</app-name>
				<app-version>1-0-0</app-version>
				<env-suffix>Pre-prod</env-suffix>
				<spring.profiles.active>pre-prod</spring.profiles.active>
				<memcached-ip>10.46.0.3:11211</memcached-ip>
				<client-secret>${CLIENT_SECRET}</client-secret>
				<client-id>${CLIENT_ID}</client-id>
				<ng-build-configuration>build</ng-build-configuration>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>m2e</id>
			<activation>
				<property>
					<name>m2e.version</name>
				</property>
			</activation>
			<properties>
				<env-suffix></env-suffix>
				<spring.profiles.active>dev</spring.profiles.active>
			</properties>
		</profile>
	</profiles>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2025.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
